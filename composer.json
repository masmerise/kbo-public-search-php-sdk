{
    "name": "masmerise/kbo-public-search-php-sdk",
    "description": "An unofficial PHP SDK for accessing the KBO/BCE Public Search web service.",
    "license": "MIT",
    "keywords": [
        "kbo",
        "bce",
        "crossroads bank for enterprises",
        "public search",
        "soap",
        "api",
        "sdk"
    ],
    "authors": [
        {
            "name": "Muhammed Sari",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/masmerise/kbo-public-search-php-sdk",
    "require": {
        "php": "~8.5",
        "ext-dom": "*",
        "ext-xmlwriter": "*",
        "saloonphp/saloon": "^4.0",
        "webmozart/assert": "^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29.0",
        "phpstan/phpstan": "^2.1.45",
        "phpunit/phpunit": "^13.0.6",
        "vlucas/phpdotenv": "^5.6.3"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "KboPublicSearch\\": "src"
        },
        "files": [
            "src/Core/Utility/transform.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "KboPublicSearch\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "stan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "test": "vendor/bin/phpunit",
        "verify": ["@stan", "@test"]
    }
}
